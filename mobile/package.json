{
  "name": "HermesPocket",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "scripts": {
    "android": "react-native run-android",
    "check:api": "npm run generate:api && git diff --exit-code -- src/generated/api",
    "codegen": "react-native codegen --path . --platform all --outputPath .codegen",
    "generate:api": "npm --prefix ../contracts run generate:mobile",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-fetch": "0.17.0",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "@react-native/new-app-screen": "0.87.0",
    "react-native-safe-area-context": "5.9.1"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/preset-env": "7.25.3",
    "@babel/runtime": "7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.0",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "codegenConfig": {
    "name": "HermesPocketSpec",
    "type": "modules",
    "jsSrcsDir": "src/native/specs",
    "android": {
      "javaPackageName": "com.hermespocket.specs"
    }
  }
}
